{
  "appId": "com.chat-toolkit.gemini-studio",
  "directories": {
    "output": "../dist"
  },
  "dmg": {
    "background": null,
    "contents": [
      {
        "type": "file",
        "x": 176,
        "y": 192
      },
      {
        "path": "/Applications",
        "type": "link",
        "x": 432,
        "y": 192
      }
    ],
    "iconSize": 128,
    "title": "GeminiStudio",
    "window": {
      "height": 400,
      "width": 660
    }
  },
  "electronDist": "node_modules/electron/dist",
  "files": [
    "**/*",
    "!user-themes",
    "!oauth_config.json",
    "!node_modules/electron",
    "!node_modules/electron-builder"
  ],
  "linux": {
    "category": "Development",
    "desktop": {
      "entry": {
        "Categories": "Development;IDE;",
        "Comment": "Gemini-powered agent for Roblox Studio",
        "Name": "GeminiStudio",
        "Type": "Application"
      }
    },
    "icon": "icons/AppLogo.png",
    "target": [
      "AppImage",
      "deb"
    ]
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "darkModeSupport": true,
    "extraResources": [
      {
        "from": "../target/release/rbx-studio-mcp",
        "to": "server"
      }
    ],
    "gatekeeperAssess": false,
    "hardenedRuntime": false,
    "icon": "icons/AppLogoWithoutBG.png",
    "identity": null,
    "target": [
      {
        "arch": [
          "x64"
        ],
        "target": "dir"
      }
    ]
  },
  "nsis": {
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "include": "installer/nsis-custom.nsh",
    "installerHeader": "icons/AppLogo.png",
    "installerIcon": "icons/AppLogo.ico",
    "installerSidebar": null,
    "license": "../LICENSE",
    "oneClick": false,
    "perMachine": false,
    "runAfterFinish": true,
    "shortcutName": "GeminiStudio",
    "uninstallDisplayName": "GeminiStudio",
    "uninstallerIcon": "icons/AppLogo.ico"
  },
  "productName": "GeminiStudio",
  "publish": null,
  "win": {
    "extraResources": [
      {
        "from": "../target/release/rbx-studio-mcp.exe",
        "to": "server.exe"
      }
    ],
    "icon": "icons/AppLogo.ico",
    "target": [
      {
        "arch": [
          "x64"
        ],
        "target": "nsis"
      }
    ]
  }
}